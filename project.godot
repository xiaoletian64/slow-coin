; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="拾光币社"
config/version="0.7.2"
boot_splash/image="res://assets/ios-icons/icon-1024.png"
boot_splash/bg_color=Color(0.067, 0.169, 0.227, 1)
boot_splash/fullsize=false
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="SlowCoin"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=450
window/size/viewport_height=900
window/size/window_width_override=450
window/size/window_height_override=900
window/energy_saving/keep_screen_on=false
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_overrides]

text_editor/behavior/indent/type=0
text_editor/behavior/indent/size=4

[input_devices]

sensors/enable_accelerometer=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.028, 0.058, 0.085, 1)
